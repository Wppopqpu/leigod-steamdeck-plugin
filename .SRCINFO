pkgbase = leigod-steamdeck-plugin
	pkgdesc = Leigod accelerator SteamDeck plugin on generic Linux via systemd SteamDeck emulation
	pkgver = 1.3.0.01
	pkgrel = 5
	url = https://www.leigod.com
	install = leigod-plugin.install
	arch = x86_64
	license = custom:proprietary
	depends = curl
	depends = iproute2
	depends = iptables
	depends = ipset
	depends = nftables
	depends = sslh
	options = !strip
	options = !debug
	backup = etc/leigod/sslh-guard.cfg
