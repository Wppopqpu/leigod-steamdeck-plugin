#!/bin/bash
# Preserve runtime binding state without placing credentials in shared /tmp.
BIND_FILE=/opt/leigod/config/accelerator.ini
STATE_DIR=/var/lib/leigod-package-state
BIND_SAVE=$STATE_DIR/accelerator.ini
RESTART_FILE=$STATE_DIR/restart-service

prepare_state_dir() {
    install -d -m700 "$STATE_DIR"
}

save_bind_state() {
    if [ -f "$BIND_FILE" ]; then
        if grep -qE '^[[:space:]]*token[[:space:]]*=[[:space:]]*[^[:space:]]' "$BIND_FILE"; then
            prepare_state_dir || return 1
            install -m600 "$BIND_FILE" "$BIND_SAVE"
        else
            # Do not resurrect an older binding after an intentional unbind.
            rm -f "$BIND_SAVE"
        fi
    fi
}

restore_bind_state() {
    if [ -f "$BIND_SAVE" ]; then
        install -m600 "$BIND_SAVE" "$BIND_FILE" || return 1
        rm -f "$BIND_SAVE"
        printf '==> Restored the saved Leigod binding state.\n'
    fi
}

pre_install() { save_bind_state; }

pre_upgrade() {
    prepare_state_dir || return 1
    rm -f "$RESTART_FILE"
    if systemctl is-active --quiet leigod; then
        install -m600 /dev/null "$RESTART_FILE" || return 1
        # Stop writers before saving configuration or replacing their files.
        systemctl stop leigod || return 1
    fi
    save_bind_state
}

pre_remove() {
    systemctl stop leigod || return 1
    # Also handle owned leftovers when the service was already inactive.
    if [ -x /usr/lib/leigod/firewall.sh ]; then
        /usr/lib/leigod/firewall.sh cleanup || printf 'WARNING: nftables cleanup failed; inspect tagged rules.\n' >&2
    fi
    if [ -x /usr/lib/leigod/ensure-wlan0.sh ]; then
        /usr/lib/leigod/ensure-wlan0.sh cleanup || printf 'WARNING: virtual interface cleanup failed; inspect wlan0.\n' >&2
    fi
    save_bind_state
}

post_install_msg() {
    printf '%s\n' \
        'Leigod plugin installed.' \
        'Start: sudo systemctl enable --now leigod' \
        'Phone: Leigod app -> hardware acceleration -> SteamDeck (same LAN).' \
        'Configuration: /etc/leigod/device.conf (pacman preserves local edits).' \
        'Ports: UDP 6066 discovery; TCP 5588 control; TCP 5589 backend.' \
        'Keep backend 5589 and debug port 10001 inaccessible from untrusted networks.' \
        'Stop/removal cleans package-tagged nftables rules and owned virtual wlan0.' \
        'Unowned/physical wlan0 and other firewall rules are preserved.' \
        'The vendor engine modifies host routes, iptables and ipset.' \
        'Check any remaining engine rules; this package never flushes mangle globally.' \
        'Documentation: /usr/share/doc/leigod-steamdeck-plugin/README.md'
}

post_install() {
    restore_bind_state || return 1
    systemctl daemon-reload
    post_install_msg
}

post_upgrade() {
    restore_bind_state || return 1
    systemctl daemon-reload || return 1
    if [ -f "$RESTART_FILE" ]; then
        rm -f "$RESTART_FILE"
        systemctl start leigod
    fi
}

post_remove() {
    systemctl daemon-reload
    printf '%s\n' \
        'Leigod removed. Owned virtual interfaces and tagged nftables rules were scheduled for cleanup.' \
        'Inspect cleanup warnings, unowned legacy wlan0, and vendor iptables/ipset leftovers if necessary.' \
        'No global firewall tables were flushed.' \
        'A private binding backup may remain in /var/lib/leigod-package-state for reinstall.' \
        'Remove that directory explicitly if you want to forget the saved binding.'
}
